# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# A pre-existing account on automationexercise.com, used by the login-based
# test case TC-02 (Login with correct email and password). Locally you keep it
# in `.env`; in CI these values come from GitHub Actions secrets.
TEST_USER_EMAIL=your-registered-email@example.com
TEST_USER_PASSWORD=your-password
